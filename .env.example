# Copy to .env.local for development, and set the same values in your host (e.g. Vercel → Settings → Environment Variables).

# Public URL of the site, used for canonical URLs, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://www.jadequest.com

# Email delivery for the inquiry and careers forms (https://resend.com).
# Without these, production forms show the email address instead of sending.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "JadeQuest Website <website@jadequest.com>"
MAIL_FROM=

# Optional recipients (defaults shown)
INQUIRY_TO=contact@jadequest.com
CAREERS_TO=careers@jadequest.com
